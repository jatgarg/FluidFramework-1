<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AssemblyName>Microsoft.Office.Web.Fluid.CsharpPortCommon</AssemblyName>
		<RootNamespace>Microsoft.Office.Web.Fluid</RootNamespace>
		<!--
			CS0649 — shim POCOs are populated via object initializers by external callers only.
		-->
		<NoWarn>$(NoWarn);CS0649</NoWarn>
	</PropertyGroup>

</Project>
