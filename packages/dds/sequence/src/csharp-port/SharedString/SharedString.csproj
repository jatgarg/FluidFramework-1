<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AssemblyName>Microsoft.Office.Web.Fluid.SharedString</AssemblyName>
		<RootNamespace>Microsoft.Office.Web.Fluid</RootNamespace>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<!--
			CS0649 — "Field is never assigned"; POCOs populated via
			object initializers by external callers only.
		-->
		<NoWarn>$(NoWarn);CS0649</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\..\csharp-port-common\CsharpPortCommon.csproj" />
	</ItemGroup>

</Project>
